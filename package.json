{
  "name": "chess-results",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first live viewer for chess-results.com team tournaments",
  "type": "module",
  "scripts": {
    "demo": "node scripts/gen-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/gen-demo.mjs && tsx --test test/*.test.ts",
    "build": "node build.mjs",
    "start": "node build.mjs && npx --yes http-server dist -p 8080 -c-1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
